{
  "name": "jev-agent-chess",
  "version": "0.1.0",
  "private": true,
  "description": "Chess web app powered by TypeSafe AI's Jev and Stockfish",
  "license": "GPL-3.0-or-later",
  "author": "Abdullah Muhammad",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "predev": "node scripts/copy-stockfish.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-stockfish.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "jev:smoke": "node --env-file-if-exists=.env.local scripts/jev-smoke.mjs",
    "jev:live": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run src/lib/jev/live.test.ts --reporter=verbose",
    "postinstall": "node scripts/copy-stockfish.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "stockfish": "^19.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
