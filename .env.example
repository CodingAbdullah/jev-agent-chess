# Copy this file to .env.local for `npm run dev`, or to .env for `docker compose`.
# Never commit the copy: git ignores both. scripts/setup.sh and setup.ps1 make
# the copy for you and ask for the key at a hidden prompt.

# Your TypeSafe AI API key. Leave empty to play against the local mock Jev.
TYPESAFE_API_KEY=

# Set to 1 to use the mock Jev even when a key is set.
JEV_MOCK=

# How many Jev requests one address may make per minute, and everyone together.
JEV_RATE_LIMIT_PER_MINUTE=30
JEV_GLOBAL_RATE_LIMIT_PER_MINUTE=300

# Optional: share the rate limits across server instances through Upstash Redis.
# Vercel's Upstash integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional TypeSafe SDK settings.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
